# ═══════════════════════════════════════════════════════════════════════════════
# GobOS — the community awnix appliance (the CentOS to the platform's RedHat)
#
# FROM the awnix base (the PUBLIC OS layer: no services, no agent, no account —
# Apache-2.0, built on centos-bootc stream9). This file adds only the GobOS
# community layer: the brand, the identity, and the GobboNet brain on top.
# The AGENT is a layer, never baked into the base — the awnix contract
# (Containerfile.awnix explains why: swapping the agent must not lose the
# guarantees the base provides).
#
# FIX THIS FILE TO REBRAND: the brand block below is the whole difference
# between GobOS and your community's edition. Change NAME/ID/PRETTY_NAME,
# drop in your icon, and `podman build` the same base.
#
# Build (inside the monorepo, next to .DEPLOYMENT/standalone/bootc/):
#   podman build -t gobos:latest -f .PRODUCTS/.GOBBONET/upstream/gobos/Containerfile.gobos .
# Licence: Apache-2.0 (same as the awnix base and every aw* package inside it)
# ═══════════════════════════════════════════════════════════════════════════════
FROM awnix-base:latest

# ── Brand block ────────────────────────────────────────────────────────────────
# THIS is what a fork changes. Everything else is the awnix base.
ENV GOBOS_NAME="GobOS" \
    GOBOS_VERSION="0.1.0" \
    GOBOS_FLAVOR="community"

# The identity a booted GobOS presents — vendor strings are the thing the
# community edition exists to drop.
RUN printf '%s\n' \
      'NAME="GobOS"' \
      'VERSION="0.1.0"' \
      'ID=gobos' \
      'ID_LIKE="centos awnix"' \
      'PRETTY_NAME="GobOS — the community awnix appliance"' \
      'HOME_URL="https://github.com/Aitherium/GobboNet"' \
      'BUG_REPORT_URL="https://github.com/Aitherium/GobboNet/issues"' \
    > /etc/os-release

# ── The GobboNet brain (agent layer, per the awnix contract) ──────────────────
# The gawbbonet agentic brick (registry id gawbbonet, formerly
# gobbonet-agentic) is the campaign brain. Installed as a layer so a
# community fork can swap the agent without touching the base.
# (The brain pack lives in the awdk/awpack tree: awpack/packs/gobbonet —
# `pip install awdk` carries it, per the registry entry.)

# ── First-boot marker ──────────────────────────────────────────────────────────
# A community appliance tells you what it is when it boots.
RUN printf '%s\n' \
      '' \
      '  GobOS — the community awnix appliance' \
      '  Fork me: https://github.com/Aitherium/GobboNet (gobos/ has the build)' \
      '' \
    > /etc/motd.d/90-gobos.conf
